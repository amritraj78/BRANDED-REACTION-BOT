# ------------------------------------------------------------------------------
# 1. CORE TELEGRAM BOT CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------
# Telegram Bot Token generated from @BotFather (e.g. 123456789:ABCdefGhIJKlmNo...)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_placeholder

# Numeric Telegram User ID of the primary owner (get via /id from @Reactions_rebot)
OWNER_ID=5423666218

# Telegram API ID & Hash from https://my.telegram.org (defaults provided in config)
# API_ID=
# API_HASH=

# ------------------------------------------------------------------------------
# 2. OWNER SOCIAL HANDLES & CHANNELS
# ------------------------------------------------------------------------------
OWNER_USERNAME=Villanns
INSTAGRAM=ex_amrit
SNAPCHAT=ex_amrit
SUPPORT_GRP=amrit_feel
UPDATE_CHNL=privatethink

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (HYBRID MULTI-TIER)
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI.
# Optional: Leave empty to run with high-speed In-Memory Engine + Telegram Cloud DB
MONGO_URL=

# Central Telegram Cloud Storage Channels/Groups (for learned Q&A, clones, backups)
DATABASE_GROUP=-1004415957871
DATABASE_CHANNEL=Yaarwinprofits
DATABASE_CHAT=-1004415957871

# ------------------------------------------------------------------------------
# 4. AI ENGINE & TOKEN OPTIMIZER
# ------------------------------------------------------------------------------
# Groq Cloud API Key (Free from https://console.groq.com/keys) - Ultra-fast 0.3s responses!
GROQ_API_KEY=

# Google Gemini 3.5 Flash API Key (Get free from https://aistudio.google.com)
# Thinking tokens are automatically capped to 0 budget for instant 1.2s responses
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. KOYEB 24/7 CLOUD HOSTING & HEALTH SENTINEL
# ------------------------------------------------------------------------------
# Internal HTTP port for health check endpoint (/health)
PORT=8000

# Public Koyeb Service URL for automated background keep-alive pings (every 25m)
# Example: https://vip-reaction-bot-yourname.koyeb.app
KOYEB_PUBLIC_URL=

# Storage & RAM sentinel alert threshold percentage (default: 90%)
STORAGE_THRESHOLD=90
